{
  "$schema": "https://mintlify.com/docs.json",
  "name": "NeetoPlaydash Docs",
  "description": "NeetoPlaydash docs for the REST API, the command-line interface, and the MCP server.",
  "theme": "mint",
  "colors": {
    "primary": "#10B981",
    "light": "#34D399",
    "dark": "#059669"
  },
  "logo": "/assets/logo.svg",
  "favicon": "/assets/favicon.ico",
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://www.neeto.com/neetoplaydash/blog"
      },
      {
        "label": "Help Center",
        "href": "https://help.neetoplaydash.com"
      },
      {
        "label": "NeetoPlaydash",
        "href": "https://neetoplaydash.com/"
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/neetohq",
      "linkedin": "https://www.linkedin.com/company/neeto",
      "youtube": "https://www.youtube.com/channel/UCoQ3Kv2JdZ51WZJ3QFFcI9g",
      "slack": "https://www.launchpass.com/neetohq"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "API",
        "icon": "code",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "api/introduction",
              "api/workspace-subdomain",
              "api/authentication",
              "api/pagination",
              "api/response-codes"
            ]
          },
          {
            "group": "Projects",
            "icon": "folder",
            "pages": [
              "api/projects/list"
            ]
          },
          {
            "group": "Insights",
            "icon": "chart-line",
            "pages": [
              "api/insights/get"
            ]
          },
          {
            "group": "Runs",
            "icon": "play",
            "pages": [
              "api/runs/list",
              "api/runs/get"
            ]
          },
          {
            "group": "Test Entities",
            "icon": "vial",
            "pages": [
              "api/test-entities/list",
              "api/test-entities/get"
            ]
          },
          {
            "group": "Result Histories",
            "icon": "clock-rotate-left",
            "pages": [
              "api/result-histories/list"
            ]
          },
          {
            "group": "Traces",
            "icon": "route",
            "pages": [
              "api/traces/list"
            ]
          },
          {
            "group": "Top Errors",
            "icon": "triangle-exclamation",
            "pages": [
              "api/top-errors/list"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "icon": "rectangle-terminal",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "cli/introduction",
              "cli/installation",
              "cli/authentication",
              "cli/output-formats",
              "cli/ai-assistants",
              "cli/troubleshooting"
            ]
          },
          {
            "group": "Commands",
            "icon": "terminal",
            "pages": [
              "cli-reference/overview",
              "cli-reference/projects",
              "cli-reference/insights",
              "cli-reference/runs",
              "cli-reference/test-entities",
              "cli-reference/result-histories",
              "cli-reference/traces",
              "cli-reference/top-errors",
              "cli-reference/utility"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "icon": "plug",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "mcp/introduction",
              "mcp/authentication",
              "mcp/connect",
              "mcp/examples",
              "mcp/troubleshooting"
            ]
          },
          {
            "group": "Reference",
            "icon": "wrench",
            "pages": [
              "mcp/tools"
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "params": {
      "expanded": "all"
    },
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "all"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "system"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "redirects": [
    {
      "source": "/getting-started/introduction",
      "destination": "/api/introduction"
    },
    {
      "source": "/getting-started/workspace-subdomain",
      "destination": "/api/workspace-subdomain"
    },
    {
      "source": "/getting-started/authentication",
      "destination": "/api/authentication"
    },
    {
      "source": "/getting-started/pagination",
      "destination": "/api/pagination"
    },
    {
      "source": "/getting-started/response-codes",
      "destination": "/api/response-codes"
    },
    {
      "source": "/api-reference/:slug*",
      "destination": "/api/:slug*"
    }
  ]
}
